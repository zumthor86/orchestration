# Shared Prefect server both work pools register against (T005)
PREFECT_API_URL=http://127.0.0.1:4200/api

# Notification target for failed/degraded runs (FR-019). Consumed by the
# conductor's notify.py ONLY — the apps never read this. Format: a webhook URL
# (Slack/Discord/etc.) or "log:" prefix for log-only mode during bring-up.
PIPELINE_ALERT_CHANNEL=log:
